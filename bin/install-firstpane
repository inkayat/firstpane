#!/usr/bin/env python3
"""Install Firstpane for the current user.

Deploys a clean release checkout to a stable per-user directory, links and
enables the Herdr plugin, and stages terminal-browser 0.13.4 plus the bundled,
checksum-pinned Add context sender patch. Installation requires a clean release
checkout from the selected public repository.

It does not install Git, Python, or Herdr, does not use sudo, does not edit
shell startup, does not open a browser, and does not restart Herdr or send
FirstMate messages. A finished file install is not a running pane.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path, PurePosixPath

REMOTE = "https://github.com/inkayat/firstpane.git"
PLUGIN_ID = "firstpane"
BROWSER_VERSION = "0.13.4"
BROWSER_DIRNAME = "terminal-browser-0.13.4"
MARKER_NAME = "install-owner.json"
OPEN_COMMAND = (
    "herdr plugin pane open --plugin firstpane --entrypoint tree"
)
DOWNLOAD_HOSTS = {
    "github.com",
    "objects.githubusercontent.com",
    "release-assets.githubusercontent.com",
    "github-releases.githubusercontent.com",
}
UNSAFE_VALUE = set("$`;|&<>\\\n\r")
DEBIAN_LIBS = "libnss3 libgtk-3-0 libasound2t64 libgbm1"


class InstallError(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="install-firstpane",
        description=(
            "Deploy Firstpane, link it in Herdr, and stage terminal-browser "
            "0.13.4 from a clean release checkout."
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="print the plan and change nothing, including no download",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="accept the printed plan without a prompt; does not guess paths",
    )
    parser.add_argument("--firstmate-home", help="absolute FirstMate operational home")
    parser.add_argument("--firstmate-root", help="absolute FirstMate tool checkout")
    parser.add_argument(
        "--without-firstmate",
        action="store_true",
        help="do not set FirstMate paths; standalone features remain",
    )
    args = parser.parse_args(argv)
    try:
        return run(args)
    except InstallError as exc:
        print(f"install-firstpane: {exc}", file=sys.stderr)
        return exc.code
    except KeyboardInterrupt:
        print("install-firstpane: interrupted; no recovery was run", file=sys.stderr)
        return 1


def run(args: argparse.Namespace) -> int:
    if args.without_firstmate and (args.firstmate_home or args.firstmate_root):
        raise InstallError(
            "--without-firstmate cannot be combined with FirstMate paths", code=2
        )
    pins = load_pins()
    reject_test_seams_outside_tests(pins)
    source = repo_root()
    platform_key = detect_platform()
    asset = asset_for(pins, platform_key)
    py = python_version(pins)
    if py < parse_version(pins["python_min"]):
        raise InstallError(
            f"Python {pins['python_min']}+ is required (found {py[0]}.{py[1]}.{py[2]}). "
            "This installer does not install or upgrade Python."
        )
    git = shutil.which("git")
    if not git:
        raise InstallError(
            "Git is required to deploy the Firstpane source. "
            "This installer does not install it."
        )
    herdr = shutil.which("herdr")
    if not herdr:
        raise InstallError(
            "Herdr 0.9.0 or newer is required and was not found on PATH. "
            "This installer does not install or upgrade Herdr. "
            "Install it from https://herdr.dev/docs/install/ and rerun."
        )
    herdr_version = read_herdr_version(herdr)
    if herdr_version < parse_version(pins["herdr_min"]):
        raise InstallError(
            f"Herdr {pins['herdr_min']}+ is required (found {fmt_version(herdr_version)}). "
            "This installer does not upgrade Herdr."
        )
    manifest = read_manifest(source)
    if manifest.get("id") != PLUGIN_ID:
        raise InstallError(f"{source} is not a Firstpane plugin checkout")
    check_source_remote(source, git, pins)
    patch = pins["sender_patch"]
    if patch.get("status") != "bundled":
        raise InstallError("sender patch is not bundled; nothing was changed", code=3)
    if patch.get("applies_to") != pins["terminal_browser"]["version"]:
        raise InstallError(
            "sender patch applies_to does not match the pinned browser version; "
            "refusing to patch a different version",
            code=3,
        )
    install_root = install_root_path()
    refuse_overlapping_foreign_source(source, install_root)
    plugins = herdr_list(herdr)
    linked = find_plugin(plugins, PLUGIN_ID)
    firstmate = resolve_firstmate(args)
    existing_config, config_dir_predicted = predict_config(args.check, herdr)
    plan = build_plan(
        source=source,
        install_root=install_root,
        platform_key=platform_key,
        asset=asset,
        patch=patch,
        linked=linked,
        firstmate=firstmate,
        existing_config=existing_config,
        config_note=config_dir_predicted,
        check=args.check,
    )
    print(plan)
    foreign = foreign_link_error(linked, planned_link_target(install_root))
    if foreign:
        raise InstallError(foreign + " Nothing was changed.")
    if args.check:
        print("check only: no files were written, no download was made, Herdr was not changed")
        return 0
    if not args.yes and not confirmed():
        raise InstallError("not confirmed; nothing was changed")
    return mutate(
        args=args,
        pins=pins,
        source=source,
        git=git,
        herdr=herdr,
        install_root=install_root,
        asset=asset,
        patch=patch,
        linked=linked,
        firstmate=firstmate,
        existing_config=existing_config,
    )


def unselected_target_message() -> str:
    return (
        "The public repository has not been selected. This local candidate is not "
        "installable. Set the reviewed release destination in REMOTE and "
        "install/pins.json before publication. Nothing was changed."
    )


def load_pins() -> dict:
    override = os.environ.get("FIRSTPANE_INSTALL_PINS")
    path = Path(override) if override else repo_root() / "install" / "pins.json"
    if not path.is_file() or path.is_symlink():
        raise InstallError(f"pins file is missing or a symlink: {path}")
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise InstallError(f"pins file is not JSON: {path}") from exc
    if not isinstance(data, dict):
        raise InstallError("pins file must be a JSON object")
    remote = data.get("firstpane_remote")
    if not REMOTE and not data.get("allow_local_source"):
        raise InstallError(unselected_target_message(), code=3)
    if remote != REMOTE and not data.get("allow_local_source"):
        raise InstallError("pins firstpane_remote is not the official Firstpane remote")
    browser = data.get("terminal_browser")
    if not isinstance(browser, dict) or browser.get("version") != BROWSER_VERSION:
        raise InstallError("pins do not pin terminal-browser 0.13.4")
    if not isinstance(data.get("sender_patch"), dict):
        raise InstallError("pins are missing sender_patch")
    return data


def reject_test_seams_outside_tests(pins: dict) -> None:
    seams = (
        "FIRSTPANE_ASSUME_PYTHON",
        "FIRSTPANE_ASSUME_PLATFORM",
        "FIRSTPANE_INSTALL_FAIL_AFTER",
        "FIRSTPANE_CHECK_LINUX_LIBS",
    )
    if os.environ.get("FIRSTPANE_INSTALL_PINS"):
        return
    set_seams = [name for name in seams if os.environ.get(name)]
    if set_seams:
        raise InstallError(
            "refusing test-only environment without FIRSTPANE_INSTALL_PINS: "
            + ", ".join(set_seams),
            code=2,
        )
    if pins.get("allow_local_source"):
        raise InstallError("production pins must not set allow_local_source", code=2)


def repo_root() -> Path:
    here = Path(__file__).resolve()
    root = here.parent.parent
    manifest = root / "herdr-plugin.toml"
    if not manifest.is_file():
        raise InstallError(f"no herdr-plugin.toml next to {here}")
    return root


def read_manifest(source: Path) -> dict:
    path = source / "herdr-plugin.toml"
    try:
        import tomllib
    except ModuleNotFoundError as exc:
        raise InstallError("Python 3.11+ is required (tomllib missing)") from exc
    try:
        return tomllib.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise InstallError(f"cannot read {path}") from exc


def parse_version(text: str) -> tuple[int, int, int]:
    parts = str(text).split(".")
    if len(parts) == 2:
        parts.append("0")
    if len(parts) != 3 or not all(part.isdigit() for part in parts):
        raise InstallError(f"unsupported version {text}")
    return tuple(int(part) for part in parts)  # type: ignore[return-value]


def fmt_version(version: tuple[int, int, int]) -> str:
    return ".".join(str(part) for part in version)


def python_version(pins: dict) -> tuple[int, int, int]:
    assumed = os.environ.get("FIRSTPANE_ASSUME_PYTHON")
    if assumed and os.environ.get("FIRSTPANE_INSTALL_PINS"):
        return parse_version(assumed)
    return sys.version_info[:3]


def detect_platform() -> str:
    assumed = os.environ.get("FIRSTPANE_ASSUME_PLATFORM")
    if assumed and os.environ.get("FIRSTPANE_INSTALL_PINS"):
        return assumed
    system = platform.system()
    machine = platform.machine()
    if system == "Darwin" and machine == "x86_64" and darwin_translated():
        machine = "arm64"
    mapping = {
        ("Darwin", "arm64"): "darwin-arm64",
        ("Darwin", "x86_64"): "darwin-x64",
        ("Linux", "x86_64"): "linux-x64",
        ("Linux", "aarch64"): "linux-arm64",
        ("Linux", "arm64"): "linux-arm64",
    }
    key = mapping.get((system, machine))
    if not key:
        raise InstallError(
            f"unsupported environment {system} {machine}. "
            "Supported: macOS and Linux, arm64 or x86_64, matching a pinned "
            "terminal-browser 0.13.4 asset. No binary was downloaded."
        )
    return key


def darwin_translated() -> bool:
    try:
        result = subprocess.run(
            ["sysctl", "-n", "sysctl.proc_translated"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return False
    return result.returncode == 0 and result.stdout.strip() == "1"


def asset_for(pins: dict, key: str) -> dict:
    assets = pins["terminal_browser"].get("assets") or {}
    asset = assets.get(key)
    if not isinstance(asset, dict):
        raise InstallError(
            f"no pinned terminal-browser 0.13.4 asset for {key}. "
            "Refusing to download a different platform."
        )
    for field in ("url", "sha256", "size"):
        if not asset.get(field):
            raise InstallError(f"pinned asset {key} is missing {field}")
    if not isinstance(asset["size"], int) or asset["size"] < 1:
        raise InstallError(f"pinned asset {key} has no size")
    return asset


def read_herdr_version(herdr: str) -> tuple[int, int, int]:
    result = run_argv([herdr, "--version"])
    text = (result.stdout or result.stderr).strip()
    prefix = "herdr "
    if not text.startswith(prefix):
        raise InstallError(f"cannot read Herdr version from {text!r}")
    return parse_version(text[len(prefix) :].split()[0])


def check_source_remote(source: Path, git: str, pins: dict) -> None:
    if pins.get("allow_local_source"):
        return
    result = run_argv([git, "-C", str(source), "remote", "get-url", "origin"])
    if result.returncode != 0:
        raise InstallError(
            f"{source} has no origin. Deploy only from {REMOTE}."
        )
    url = result.stdout.strip()
    if canonical_remote(url) != canonical_remote(REMOTE):
        raise InstallError(
            f"refusing source origin {url}; official remote is {REMOTE}"
        )


def canonical_remote(url: str) -> str:
    text = url.strip().rstrip("/")
    if text.startswith("git@github.com:"):
        text = "https://github.com/" + text.split(":", 1)[1]
    if text.endswith(".git"):
        text = text[:-4]
    return text


def install_root_path() -> Path:
    data_home = data_home_path()
    root = data_home / "firstpane"
    if root.is_symlink():
        raise InstallError(f"refusing symlink install root {root}")
    return root


def data_home_path() -> Path:
    raw = os.environ.get("XDG_DATA_HOME")
    if raw:
        if not Path(raw).is_absolute() or "\x00" in raw:
            raise InstallError("XDG_DATA_HOME must be an absolute path")
        path = Path(raw)
    else:
        home = os.environ.get("HOME")
        if not home or not Path(home).is_absolute():
            raise InstallError("HOME must be set to an absolute path")
        path = Path(home) / ".local" / "share"
    resolved = path.resolve()
    if resolved.is_symlink():
        raise InstallError(f"refusing symlink data home {path}")
    return resolved


def refuse_overlapping_foreign_source(source: Path, install_root: Path) -> None:
    source_real = source.resolve()
    root_real = install_root.resolve() if install_root.exists() else install_root
    stable = (install_root / "src")
    try:
        stable_real = stable.resolve()
    except OSError:
        stable_real = stable
    if source_real == stable_real:
        return
    if source_real == root_real or root_real in source_real.parents or _is_relative_to(source_real, root_real):
        raise InstallError(
            "refusing to deploy a checkout that overlaps the install root. "
            f"Clone to a bootstrap directory, then run this installer. Root: {install_root}"
        )


def _is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def herdr_list(herdr: str) -> list[dict]:
    result = run_argv([herdr, "plugin", "list", "--json"])
    if result.returncode != 0:
        raise InstallError(
            "herdr plugin list --json failed; not linking. "
            + (result.stderr or result.stdout).strip()
        )
    try:
        payload = json.loads(result.stdout)
    except ValueError as exc:
        raise InstallError("herdr plugin list --json was not JSON") from exc
    result_body = payload.get("result") if isinstance(payload, dict) else None
    if not isinstance(result_body, dict) or result_body.get("type") != "plugin_list":
        raise InstallError("herdr plugin list JSON has no plugin_list result")
    plugins = result_body.get("plugins")
    if not isinstance(plugins, list):
        raise InstallError("herdr plugin list JSON has no plugins array")
    return plugins


def find_plugin(plugins: list[dict], plugin_id: str) -> dict | None:
    found = [item for item in plugins if item.get("plugin_id") == plugin_id]
    if len(found) > 1:
        raise InstallError(f"Herdr listed {plugin_id} more than once; refusing to link")
    return found[0] if found else None


def resolve_firstmate(args: argparse.Namespace) -> dict:
    if args.without_firstmate:
        return {"mode": "skip", "home": None, "root": None}
    explicit = explicit_firstmate(args)
    if explicit:
        return explicit
    discovered = discover_firstmate()
    if discovered.get("ambiguous"):
        if args.check or args.yes:
            return {
                "mode": "standalone",
                "home": None,
                "root": None,
                "reason": discovered["reason"],
            }
        return prompt_firstmate(discovered["reason"])
    return discovered


def explicit_firstmate(args: argparse.Namespace) -> dict | None:
    if not args.firstmate_home and not args.firstmate_root:
        return None
    if not args.firstmate_home or not args.firstmate_root:
        raise InstallError(
            "pass both --firstmate-home and --firstmate-root, or neither"
        )
    home = validate_user_path(args.firstmate_home, "firstmate_home", must_exist=True)
    root = validate_user_path(args.firstmate_root, "firstmate_root", must_exist=True)
    require_distinct_firstmate(home, root)
    inbox = root / "bin" / "fm-inbox.sh"
    if not inbox.is_file():
        raise InstallError(f"{root} has no bin/fm-inbox.sh; not a FirstMate tool checkout")
    return {"mode": "explicit", "home": home, "root": root}


def discover_firstmate() -> dict:
    file_values, file_error = read_launcher_env()
    env_values = {
        "FM_HOME": os.environ.get("FM_HOME"),
        "FIRSTMATE_ROOT": os.environ.get("FIRSTMATE_ROOT"),
    }
    if file_error:
        return {"ambiguous": True, "reason": file_error}
    home = file_values.get("FM_HOME") or env_values.get("FM_HOME")
    root = file_values.get("FIRSTMATE_ROOT") or env_values.get("FIRSTMATE_ROOT")
    file_home = file_values.get("FM_HOME")
    file_root = file_values.get("FIRSTMATE_ROOT")
    env_home = env_values.get("FM_HOME")
    env_root = env_values.get("FIRSTMATE_ROOT")
    if file_home and env_home and file_home != env_home:
        return {
            "ambiguous": True,
            "reason": "launcher env and FM_HOME disagree; pass --firstmate-home",
        }
    if file_root and env_root and file_root != env_root:
        return {
            "ambiguous": True,
            "reason": "launcher env and FIRSTMATE_ROOT disagree; pass --firstmate-root",
        }
    if not home and not root:
        return {
            "ambiguous": True,
            "reason": "no FirstMate paths in launcher config or FM_HOME/FIRSTMATE_ROOT",
        }
    if not home or not root:
        return {
            "ambiguous": True,
            "reason": "only one of FirstMate home and root was found",
        }
    try:
        home_path = validate_user_path(home, "FM_HOME", must_exist=True)
        root_path = validate_user_path(root, "FIRSTMATE_ROOT", must_exist=True)
        require_distinct_firstmate(home_path, root_path)
    except InstallError as exc:
        return {"ambiguous": True, "reason": str(exc)}
    if not (root_path / "bin" / "fm-inbox.sh").is_file():
        return {
            "ambiguous": True,
            "reason": f"{root_path} has no bin/fm-inbox.sh",
        }
    return {"mode": "discovered", "home": home_path, "root": root_path, "ambiguous": False}


def read_launcher_env() -> tuple[dict, str | None]:
    override = os.environ.get("FM_CONFIG_ENV")
    if override:
        if not Path(override).is_absolute() or "\x00" in override:
            return {}, "FM_CONFIG_ENV must be an absolute path"
        path = Path(override)
    else:
        home = os.environ.get("HOME")
        if not home:
            return {}, "HOME is unset"
        path = Path(home) / ".config" / "firstmate-config" / "env"
    if not path.exists():
        return {}, None
    if path.is_symlink() or not path.is_file():
        return {}, f"refusing launcher env that is not a regular file: {path}"
    values = {}
    try:
        lines = path.read_text().splitlines()
    except OSError as exc:
        return {}, f"cannot read launcher env {path}: {exc}"
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "=" not in stripped:
            continue
        key, raw = stripped.split("=", 1)
        if key not in {"FM_HOME", "FIRSTMATE_ROOT"}:
            continue
        value = unquote_literal(raw)
        if value is None or any(char in UNSAFE_VALUE for char in value):
            return {}, f"refusing unsafe {key} in {path}"
        values[key] = value
    return values, None


def unquote_literal(raw: str) -> str | None:
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in {"'", '"'}:
        return raw[1:-1]
    if raw[:1] in {"'", '"'} or raw[-1:] in {"'", '"'}:
        return None
    return raw


def prompt_firstmate(reason: str) -> dict:
    print(
        "FirstMate paths were not discovered "
        f"({reason}). Standalone Firstpane still lists Herdr agents and can read "
        "or comment on pull requests, but cannot fill FirstMate's message box or "
        "send notes. Enter an absolute firstmate_home, or 'skip': ",
        end="",
        flush=True,
    )
    home_line = sys.stdin.readline()
    if not home_line:
        raise InstallError("no answer for FirstMate home; nothing was changed")
    home_line = home_line.strip()
    if home_line.lower() in {"", "skip"}:
        return {"mode": "skip", "home": None, "root": None}
    print("Enter an absolute firstmate_root: ", end="", flush=True)
    root_line = sys.stdin.readline()
    if not root_line:
        raise InstallError("no answer for FirstMate root; nothing was changed")
    home = validate_user_path(home_line, "firstmate_home", must_exist=True)
    root = validate_user_path(root_line.strip(), "firstmate_root", must_exist=True)
    require_distinct_firstmate(home, root)
    if not (root / "bin" / "fm-inbox.sh").is_file():
        raise InstallError(f"{root} has no bin/fm-inbox.sh")
    return {"mode": "prompt", "home": home, "root": root}


def require_distinct_firstmate(home: Path, root: Path) -> None:
    if home.resolve() == root.resolve():
        raise InstallError("firstmate_home and firstmate_root must be different directories")


def validate_user_path(value: str, label: str, must_exist: bool) -> Path:
    if not value or "\x00" in value or any(char in UNSAFE_VALUE for char in value):
        raise InstallError(f"refusing unsafe {label}")
    path = Path(value)
    if not path.is_absolute():
        raise InstallError(f"{label} must be absolute")
    if path.is_symlink():
        raise InstallError(f"refusing symlink {label}: {path}")
    resolved = path.resolve()
    if must_exist and not resolved.is_dir():
        raise InstallError(f"{label} is not a directory: {path}")
    return resolved


def predict_config(check: bool, herdr: str) -> tuple[dict, str]:
    expected = expected_config_dir()
    note = (
        f"config directory will be requested from herdr plugin config-dir "
        f"(expected under {expected.parent})"
    )
    if check:
        return {}, note
    return {}, note


def expected_config_dir() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        if not Path(xdg).is_absolute():
            raise InstallError("XDG_CONFIG_HOME must be absolute")
        base = Path(xdg)
    else:
        home = os.environ.get("HOME")
        if not home:
            raise InstallError("HOME is unset")
        base = Path(home) / ".config"
    return (base / "herdr" / "plugins" / "config" / PLUGIN_ID).resolve()


def build_plan(
    source: Path,
    install_root: Path,
    platform_key: str,
    asset: dict,
    patch: dict,
    linked: dict | None,
    firstmate: dict,
    existing_config: dict,
    config_note: str,
    check: bool,
) -> str:
    link_line = "link herdr plugin firstpane to the stable source"
    if linked:
        kind = (linked.get("source") or {}).get("kind")
        root = linked.get("plugin_root")
        link_line = (
            f"already listed by Herdr at {root} ({kind}, "
            f"enabled={linked.get('enabled')}); will keep it only if it is this install"
        )
    fm_line = firstmate_plan_line(firstmate)
    lines = [
        "Firstpane install plan",
        f"- source checkout: {source}",
        f"- stable install root: {install_root}",
        f"- platform asset: terminal-browser {BROWSER_VERSION} {platform_key}",
        f"- download: {asset['url']}",
        f"- sha256: {asset['sha256']}",
        f"- sender patch: {patch.get('identity')} ({patch.get('status')})",
        f"- {link_line}",
        "- enable firstpane if Herdr reports it disabled",
        f"- {config_note}",
        "- preserve unknown config keys, drafts, and existing valid paths",
        f"- FirstMate: {fm_line}",
        "- will not sudo, install system packages, edit shell startup, open a browser,",
        "  restart Herdr, send FirstMate messages, or start a pane",
        f"- after a successful file install, you open it with: {OPEN_COMMAND}",
        "- that open command is not run by this installer",
    ]
    if check:
        lines.append("- mode: check (no mutation, no download)")
    else:
        lines.append("- mode: install (asks for confirmation unless --yes)")
    return "\n".join(lines)


def firstmate_plan_line(firstmate: dict) -> str:
    mode = firstmate.get("mode")
    if mode in {"skip", "standalone"}:
        reason = firstmate.get("reason") or "not configured"
        return (
            f"standalone ({reason}). Agents and pull requests still work; "
            "FirstMate message box and notes do not."
        )
    return f"{mode} home={firstmate.get('home')} root={firstmate.get('root')}"


def confirmed() -> bool:
    print("Proceed? [y/N] ", end="", flush=True)
    line = sys.stdin.readline()
    return bool(line) and line.strip().lower() in {"y", "yes"}


def mutate(
    args: argparse.Namespace,
    pins: dict,
    source: Path,
    git: str,
    herdr: str,
    install_root: Path,
    asset: dict,
    patch: dict,
    linked: dict | None,
    firstmate: dict,
    existing_config: dict,
) -> int:
    ensure_owned_root(install_root)
    staging = install_root / f".staging-{os.getpid()}"
    if staging.exists() or staging.is_symlink():
        raise InstallError(f"refusing unexpected staging path {staging}")
    staging.mkdir(mode=0o700)
    preserved_browser = preserved_browser_path()
    try:
        browser_stage = None
        if preserved_browser is None and not installed_browser_ready(install_root, patch):
            browser_stage = stage_browser(staging, pins, asset, patch)
        fail_after("after-extract")
        source_path = activate_source(source, git, install_root, staging)
        if browser_stage is not None:
            activate_browser(browser_stage, install_root)
        fail_after("after-activate")
        ensure_link(herdr, source_path, linked)
        config_dir = herdr_config_dir(herdr)
        config_path = config_dir / "config.json"
        prior = read_config(config_path)
        write_config(config_path, prior, install_root, firstmate, preserved_browser)
        libs = None if preserved_browser else linux_library_gaps(install_root / BROWSER_DIRNAME)
    except InstallError:
        cleanup_staging(staging)
        raise
    except Exception as exc:
        cleanup_staging(staging)
        raise InstallError(
            "install failed after staging; active source and config were left "
            f"as they were if activation had not finished. Staging removed if it "
            f"was still ours. Recovery: rerun this installer. Previous trees, if "
            f"any, remain under {install_root}. ({exc})"
        ) from exc
    cleanup_staging(staging)
    print(success_message(install_root, source_path, libs))
    if libs is not None:
        raise InstallError(libs, code=4)
    return 0


def fail_after(point: str) -> None:
    if not os.environ.get("FIRSTPANE_INSTALL_PINS"):
        return
    if os.environ.get("FIRSTPANE_INSTALL_FAIL_AFTER") != point:
        return
    if point == "after-activate":
        raise InstallError(
            "stopped after activation by FIRSTPANE_INSTALL_FAIL_AFTER. "
            "Source and browser files may already be in place. Herdr was not linked "
            "and config was not written. Recovery: rerun without "
            "FIRSTPANE_INSTALL_FAIL_AFTER. Do not delete the install root."
        )
    raise InstallError(
        f"stopped at {point} by FIRSTPANE_INSTALL_FAIL_AFTER. "
        "Active source, browser, and config were not replaced. "
        "Recovery: rerun without FIRSTPANE_INSTALL_FAIL_AFTER. "
        "Do not delete the install root or Herdr config."
    )


def ensure_owned_root(install_root: Path) -> None:
    data_home = install_root.parent
    if data_home.is_symlink():
        raise InstallError(f"refusing symlink data home {data_home}")
    if not data_home.exists():
        data_home.mkdir(parents=True, mode=0o700)
    if not data_home.is_dir():
        raise InstallError(f"refusing data home {data_home}")
    if install_root.is_symlink():
        raise InstallError(f"refusing symlink install root {install_root}")
    if not install_root.exists():
        install_root.mkdir(mode=0o700)
        write_marker(install_root)
        return
    if not install_root.is_dir():
        raise InstallError(f"refusing non-directory install root {install_root}")
    assert_owned(install_root)


def write_marker(install_root: Path) -> None:
    marker = install_root / MARKER_NAME
    if marker.exists() or marker.is_symlink():
        raise InstallError(f"refusing to replace marker {marker}")
    payload = json.dumps(
        {"installer": "firstpane", "root": str(install_root.resolve())}
    ).encode()
    write_new_file(marker, payload, 0o600)


def assert_owned(install_root: Path) -> None:
    marker = install_root / MARKER_NAME
    info = marker.lstat() if marker.exists() or marker.is_symlink() else None
    if info is None or stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise InstallError(
            f"refusing to modify {install_root}: no Firstpane ownership marker. "
            "This installer will not replace a foreign directory."
        )
    try:
        data = json.loads(marker.read_text())
    except (OSError, ValueError) as exc:
        raise InstallError(f"refusing unreadable ownership marker {marker}") from exc
    if data.get("installer") != "firstpane":
        raise InstallError(f"refusing foreign marker at {marker}")
    if data.get("root") != str(install_root.resolve()):
        raise InstallError(
            f"ownership marker root does not match {install_root}; refusing"
        )


def stage_browser(staging: Path, pins: dict, asset: dict, patch: dict) -> Path:
    archive = staging / "terminal-browser.tar.gz"
    download(asset["url"], archive, asset["sha256"], asset["size"])
    extracted = staging / "browser"
    extracted.mkdir(mode=0o700)
    max_bytes = int(pins["terminal_browser"].get("max_uncompressed_bytes") or 800_000_000)
    safe_extract(archive, extracted, max_bytes)
    runtime = locate_runtime(extracted)
    apply_sender_patch(runtime, staging, patch, max_bytes)
    version = (runtime / "VERSION").read_text().strip()
    if version != BROWSER_VERSION:
        raise InstallError(
            f"extracted VERSION is {version!r}, expected {BROWSER_VERSION}; not activating"
        )
    binary = runtime / "bin" / "terminal-browser"
    if not binary.is_file() or binary.is_symlink() or not os.access(binary, os.X_OK):
        raise InstallError("extracted tree has no executable bin/terminal-browser")
    return runtime


def download(url: str, dest: Path, expected_sha: str, expected_size: int) -> None:
    check_url(url)
    parsed = urllib.request.urlparse(url)
    if parsed.scheme == "file":
        source = Path(urllib.request.url2pathname(parsed.path))
        try:
            data = source.read_bytes()
        except OSError as exc:
            raise InstallError(f"cannot read {url}: {exc}") from exc
        digest = hashlib.sha256(data).hexdigest()
        if len(data) != expected_size or digest != expected_sha.lower():
            raise InstallError(
                f"checksum or size mismatch for {url}: "
                f"got {len(data)} bytes sha256 {digest}; pinned {expected_size} {expected_sha}. "
                "Nothing was activated."
            )
        write_new_file(dest, data, 0o600)
        return
    request = urllib.request.Request(url, method="GET")
    opener = urllib.request.build_opener(PinnedRedirectHandler())
    try:
        with opener.open(request, timeout=60) as response:
            status = getattr(response, "status", 200)
            if status != 200:
                raise InstallError(f"download status {status} for {url}")
            hasher = hashlib.sha256()
            total = 0
            with dest.open("wb") as handle:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > expected_size:
                        raise InstallError(
                            f"download exceeded pinned size {expected_size} for {url}"
                        )
                    hasher.update(chunk)
                    handle.write(chunk)
                handle.flush()
                os.fsync(handle.fileno())
    except InstallError:
        dest.unlink(missing_ok=True)
        raise
    except urllib.error.URLError as exc:
        dest.unlink(missing_ok=True)
        raise InstallError(f"download failed for {url}: {exc.reason}") from exc
    digest = hasher.hexdigest()
    if total != expected_size or digest != expected_sha.lower():
        dest.unlink(missing_ok=True)
        raise InstallError(
            f"checksum or size mismatch for {url}: "
            f"got {total} bytes sha256 {digest}; pinned {expected_size} {expected_sha}. "
            "Nothing was activated."
        )


def check_url(url: str) -> None:
    parsed = urllib.request.urlparse(url)
    if parsed.username or parsed.password:
        raise InstallError(f"refusing credentials in download URL {url}")
    test_mode = bool(os.environ.get("FIRSTPANE_INSTALL_PINS"))
    if test_mode:
        if parsed.scheme == "file" and parsed.netloc in {"", "localhost"}:
            return
        if parsed.scheme in {"http", "https"} and parsed.hostname in {"127.0.0.1", "::1"}:
            return
        raise InstallError(f"refusing non-fixture URL in test mode: {url}")
    if parsed.scheme != "https" or parsed.hostname not in DOWNLOAD_HOSTS:
        raise InstallError(f"refusing download URL {url}")


class PinnedRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def safe_extract(archive: Path, dest: Path, max_bytes: int) -> None:
    if dest.is_symlink() or not dest.is_dir():
        raise InstallError(f"refusing extract destination {dest}")
    written = 0
    with tarfile.open(archive, "r:gz") as tar:
        members = tar.getmembers()
        if len(members) > 20000:
            raise InstallError("refusing archive with too many members")
        for member in members:
            written += extract_member(tar, member, dest, max_bytes - written)
    if not any(dest.iterdir()):
        raise InstallError("archive extracted no files")


def extract_member(tar: tarfile.TarFile, member: tarfile.TarInfo, dest: Path, budget: int) -> int:
    name = member.name
    if not name or name.startswith("/") or "\\" in name or "\x00" in name:
        raise InstallError(f"refusing archive path {name!r}")
    parts = PurePosixPath(name).parts
    if not parts or ".." in parts or any(part in {"", ".", ".."} for part in parts):
        raise InstallError(f"refusing archive path {name!r}")
    if member.isdev() or member.isfifo() or member.islnk():
        raise InstallError(f"refusing special archive member {name}")
    current = dest
    for part in parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise InstallError(f"refusing to traverse symlink {current}")
        if current.exists() and not current.is_dir():
            raise InstallError(f"refusing non-directory parent {current}")
        if not current.exists():
            current.mkdir(mode=0o755)
    final = dest.joinpath(*parts)
    if final.is_symlink():
        raise InstallError(f"refusing to write through symlink {final}")
    if member.type in {
        tarfile.XHDTYPE,
        tarfile.XGLTYPE,
        tarfile.GNUTYPE_LONGNAME,
        tarfile.GNUTYPE_LONGLINK,
    }:
        return 0
    if member.isdir():
        final.mkdir(mode=0o755, exist_ok=True)
        return 0
    if member.issym():
        if not link_stays_inside(dest, final, member.linkname):
            raise InstallError(f"refusing escaping symlink {name} -> {member.linkname}")
        if final.exists():
            raise InstallError(f"refusing to replace {final} with a symlink")
        os.symlink(member.linkname, final)
        return 0
    if not member.isfile():
        raise InstallError(f"refusing archive member type for {name}")
    if member.size < 0 or member.size > budget:
        raise InstallError(f"refusing archive member size for {name}")
    source = tar.extractfile(member)
    if source is None:
        raise InstallError(f"cannot read archive member {name}")
    data = source.read(member.size + 1)
    if len(data) != member.size:
        raise InstallError(f"archive member size mismatch for {name}")
    write_new_file(final, data, 0o755 if member.mode & 0o111 else 0o644)
    return len(data)


def link_stays_inside(dest: Path, link_path: Path, linkname: str) -> bool:
    """Lexical check only. Do not resolve existing symlinks."""
    if not linkname or linkname.startswith("/") or "\x00" in linkname or "\\" in linkname:
        return False
    try:
        base = list(link_path.parent.relative_to(dest).parts)
    except ValueError:
        return False
    stack = base
    for part in PurePosixPath(linkname).parts:
        if part in {"", "."}:
            continue
        if part == "..":
            if not stack:
                return False
            stack.pop()
            continue
        stack.append(part)
    return True


def write_new_file(path: Path, data: bytes, mode: int) -> None:
    if path.is_symlink() or path.exists():
        raise InstallError(f"refusing to overwrite {path}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)


def locate_runtime(extracted: Path) -> Path:
    candidates = []
    direct = extracted / "bin" / "terminal-browser"
    if direct.is_file():
        candidates.append(extracted)
    for child in extracted.iterdir():
        if child.is_dir() and not child.is_symlink():
            nested = child / "bin" / "terminal-browser"
            if nested.is_file() and not nested.is_symlink():
                candidates.append(child)
    if len(candidates) != 1:
        raise InstallError(
            "archive does not contain exactly one bin/terminal-browser; not activating"
        )
    return candidates[0]


def apply_sender_patch(runtime: Path, staging: Path, patch: dict, max_bytes: int) -> None:
    del max_bytes
    files = patch.get("files")
    substitutions = patch.get("substitutions") if isinstance(patch.get("substitutions"), dict) else {}
    apply = patch.get("apply") if isinstance(patch.get("apply"), dict) else {}
    if not isinstance(files, list) or not files:
        raise InstallError("bundled sender patch has no files; refusing", code=3)
    for item in files:
        require_patch_state(runtime, item, "pre_sha256", "pre_size", "does not apply")
    tool = staging / "patch-tool"
    tool.mkdir(mode=0o700)
    for spec, name in (
        (substitutions, "terminal-browser-0.13.4-context-substitutions.json"),
        (apply, "apply-terminal-browser-0.13.4-context.py"),
    ):
        source = repo_root() / "docs" / name
        if source.is_symlink() or not source.is_file():
            raise InstallError(f"bundled patch helper missing or a symlink: {name}", code=3)
        data = source.read_bytes()
        if len(data) != spec.get("size") or hashlib.sha256(data).hexdigest() != spec.get("sha256"):
            raise InstallError(f"bundled patch helper checksum or size mismatch: {name}", code=3)
        write_new_file(tool / name, data, 0o600)
    script = tool / "apply-terminal-browser-0.13.4-context.py"
    result = run_argv([sys.executable, str(script), str(runtime)])
    if result.returncode != 0:
        raise InstallError(
            "sender patch script failed; nothing was activated. "
            + (result.stderr or result.stdout).strip()
        )
    for item in files:
        require_patch_state(runtime, item, "post_sha256", "post_size", "result mismatch")


def safe_relative(value: str) -> bool:
    parts = PurePosixPath(value).parts
    return bool(parts) and ".." not in parts and not value.startswith("/")


def sha256_file(path: Path) -> str:
    hasher = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def require_patch_state(runtime: Path, item: dict, digest_key: str, size_key: str, label: str) -> None:
    relative = item.get("path")
    if not isinstance(relative, str) or not safe_relative(relative):
        raise InstallError("sender patch file path is unsafe")
    current = runtime / relative
    if not current.is_file() or current.is_symlink():
        raise InstallError(f"patch target missing or a symlink: {relative}")
    found = sha256_file(current)
    size = current.stat().st_size
    expected_size = item.get(size_key)
    if found != item.get(digest_key) or (expected_size is not None and size != expected_size):
        raise InstallError(
            f"sender patch {label} for {relative}: found {found} ({size} bytes). "
            "Refusing to patch a different version. Nothing was activated."
        )


def activate_source(source: Path, git: str, install_root: Path, staging: Path) -> Path:
    assert_owned(install_root)
    destination = install_root / "src"
    if destination.is_symlink():
        raise InstallError(f"refusing symlink source path {destination}")
    if source.resolve() == destination.resolve():
        if dirty(source, git):
            raise InstallError(f"refusing to link dirty checkout {source}")
        return destination
    if destination.is_dir() and same_commit(source, destination, git):
        return destination
    if dirty(source, git):
        raise InstallError(
            f"{source} has uncommitted changes. Commit or use a clean published checkout."
        )
    staged = staging / "src"
    result = run_argv(
        [
            git,
            "-c",
            "core.hooksPath=/dev/null",
            "clone",
            "--local",
            "--no-hardlinks",
            "--",
            str(source),
            str(staged),
        ]
    )
    if result.returncode != 0:
        raise InstallError("git clone of the Firstpane source failed: " + result.stderr.strip())
    if read_manifest(staged).get("id") != PLUGIN_ID:
        raise InstallError("cloned source is not Firstpane")
    assert_owned(install_root)
    if destination.exists():
        previous = install_root / "src.previous"
        if previous.exists() or previous.is_symlink():
            raise InstallError(
                f"refusing to discard existing {previous}. "
                "Recovery: move that previous tree aside yourself, then rerun. "
                "The active source was not replaced."
            )
        os.rename(destination, previous)
    os.rename(staged, destination)
    return destination


def same_commit(source: Path, destination: Path, git: str) -> bool:
    if not (destination / ".git").exists():
        return False
    current = run_argv([git, "-C", str(source), "rev-parse", "HEAD"])
    installed = run_argv([git, "-C", str(destination), "rev-parse", "HEAD"])
    return (
        current.returncode == 0
        and installed.returncode == 0
        and bool(current.stdout.strip())
        and current.stdout.strip() == installed.stdout.strip()
    )


def dirty(source: Path, git: str) -> bool:
    result = run_argv([git, "-C", str(source), "status", "--porcelain"])
    if result.returncode != 0:
        raise InstallError(f"cannot read git status of {source}")
    return bool(result.stdout.strip())


def activate_browser(runtime: Path, install_root: Path) -> None:
    assert_owned(install_root)
    destination = install_root / BROWSER_DIRNAME
    if destination.is_symlink():
        raise InstallError(f"refusing symlink browser path {destination}")
    if destination.exists():
        previous = install_root / f"{BROWSER_DIRNAME}.previous"
        if previous.exists() or previous.is_symlink():
            raise InstallError(
                f"refusing to discard {previous}. Active browser was not replaced. "
                "Recovery: move that previous tree aside only if you own it, then rerun."
            )
        os.rename(destination, previous)
    os.rename(runtime, destination)


def planned_link_target(install_root: Path) -> str:
    return str((install_root / "src").resolve())


def foreign_link_error(linked: dict | None, target: str) -> str | None:
    if not linked:
        return None
    kind = (linked.get("source") or {}).get("kind")
    existing = linked.get("plugin_root")
    if kind != "local":
        return (
            f"firstpane is already installed from {kind} at {existing}. "
            "This installer will not unlink, replace, or overwrite it."
        )
    try:
        existing_real = str(Path(existing).resolve())
    except (OSError, TypeError):
        return f"cannot resolve existing plugin root {existing}"
    if existing_real != target:
        return (
            f"firstpane is already linked at {existing_real}, not {target}. "
            "This installer will not replace that link or touch that directory."
        )
    return None


def ensure_link(herdr: str, source_path: Path, linked: dict | None) -> None:
    target = str(source_path.resolve())
    foreign = foreign_link_error(linked, target)
    if foreign:
        raise InstallError(foreign)
    if linked:
        if linked.get("enabled") is True:
            return
        result = run_argv([herdr, "plugin", "enable", PLUGIN_ID])
        if result.returncode != 0:
            raise InstallError("herdr plugin enable firstpane failed: " + result.stderr.strip())
        return
    result = run_argv([herdr, "plugin", "link", target])
    if result.returncode != 0:
        raise InstallError("herdr plugin link failed: " + result.stderr.strip())
    enabled = run_argv([herdr, "plugin", "enable", PLUGIN_ID])
    if enabled.returncode != 0:
        raise InstallError("herdr plugin enable firstpane failed: " + enabled.stderr.strip())


def herdr_config_dir(herdr: str) -> Path:
    result = run_argv([herdr, "plugin", "config-dir", PLUGIN_ID])
    if result.returncode != 0:
        raise InstallError("herdr plugin config-dir failed: " + result.stderr.strip())
    text = result.stdout.strip()
    if "\n" in text or not text or "\x00" in text or not Path(text).is_absolute():
        raise InstallError(f"refusing herdr config-dir output {text!r}")
    path = Path(text)
    if path.is_symlink():
        raise InstallError(f"refusing symlink config dir {path}")
    expected = expected_config_dir()
    resolved = path.resolve()
    if resolved != expected:
        raise InstallError(
            f"herdr config-dir {resolved} is not the expected {expected}; not writing config"
        )
    if not resolved.is_dir():
        raise InstallError(f"config dir does not exist: {resolved}")
    return resolved


def read_config(path: Path) -> dict:
    if path.is_symlink():
        raise InstallError(f"refusing symlink config {path}")
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise InstallError(
            f"existing {path} is not JSON; left unchanged. Fix it and rerun."
        ) from exc
    if not isinstance(data, dict):
        raise InstallError(f"existing {path} is not a JSON object; left unchanged")
    return data


def preserved_browser_path() -> Path | None:
    path = expected_config_dir() / "config.json"
    if not path.is_file() or path.is_symlink():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    raw = data.get("terminal_browser_root")
    if not isinstance(raw, str) or not raw:
        return None
    candidate = Path(raw)
    if candidate.is_absolute() and not candidate.is_symlink() and valid_browser(candidate):
        return candidate.resolve()
    return None


def installed_browser_ready(install_root: Path, patch: dict) -> bool:
    runtime = install_root / BROWSER_DIRNAME
    if not valid_browser(runtime):
        return False
    for item in patch.get("files") or []:
        relative = item.get("path")
        if not isinstance(relative, str):
            return False
        target = runtime / relative
        if not target.is_file() or target.is_symlink():
            return False
        if sha256_file(target) != item.get("post_sha256"):
            return False
        if item.get("post_size") is not None and target.stat().st_size != item.get("post_size"):
            return False
    return True


def write_config(
    path: Path,
    prior: dict,
    install_root: Path,
    firstmate: dict,
    preserved_browser: Path | None,
) -> None:
    updated = dict(prior)
    changed = False
    browser = preserved_browser or (install_root / BROWSER_DIRNAME)
    changed = fill_if_absent(updated, "terminal_browser_root", str(browser), valid_browser) or changed
    if firstmate.get("home") and firstmate.get("root"):
        changed = fill_if_absent(
            updated, "firstmate_home", str(firstmate["home"]), Path.is_dir
        ) or changed
        changed = fill_if_absent(
            updated, "firstmate_root", str(firstmate["root"]), valid_fm_root
        ) or changed
    if not changed:
        return
    payload = json.dumps(updated, indent=2).encode() + b"\n"
    temporary = path.with_name(f".config.{os.getpid()}.tmp")
    if temporary.exists() or temporary.is_symlink():
        raise InstallError(f"refusing temp config path {temporary}")
    write_new_file(temporary, payload, 0o600)
    os.replace(temporary, path)


def fill_if_absent(config: dict, key: str, value: str, valid) -> bool:
    current = config.get(key)
    if current:
        candidate = Path(str(current))
        if candidate.is_absolute() and not candidate.is_symlink() and valid(candidate):
            return False
        raise InstallError(
            f"existing {key} is set but not a valid path ({current}). "
            "Left unchanged. Fix or remove that key and rerun; "
            "this installer will not overwrite it."
        )
    config[key] = value
    return True


def valid_browser(path: Path) -> bool:
    binary = path / "bin" / "terminal-browser"
    version = path / "VERSION"
    return binary.is_file() and not binary.is_symlink() and version.is_file() and version.read_text().strip() == BROWSER_VERSION


def valid_fm_root(path: Path) -> bool:
    return (path / "bin" / "fm-inbox.sh").is_file()


def elf_library_target(runtime: Path) -> Path | None:
    for relative in ("electron/pixel", "bin/terminal-browser"):
        path = runtime / relative
        if not path.is_file() or path.is_symlink():
            continue
        try:
            with path.open("rb") as handle:
                magic = handle.read(4)
        except OSError:
            continue
        if magic == b"\x7fELF":
            return path
    return None


def linux_library_gaps(runtime: Path) -> str | None:
    assumed = os.environ.get("FIRSTPANE_ASSUME_PLATFORM") or ""
    real_linux = platform.system() == "Linux" or (
        assumed.startswith("linux") and bool(os.environ.get("FIRSTPANE_INSTALL_PINS"))
    )
    forced = os.environ.get("FIRSTPANE_CHECK_LINUX_LIBS") == "1" and bool(
        os.environ.get("FIRSTPANE_INSTALL_PINS")
    )
    if not real_linux and not forced:
        return None
    ldd = shutil.which("ldd")
    target = elf_library_target(runtime)
    if target is None and not forced:
        return None
    if target is None:
        target = runtime / "bin" / "terminal-browser"
    if not ldd or not target.is_file():
        return (
            "Linux runtime libraries were not verified "
            f"(ldd={ldd}, binary={target}). This installer did not install packages. "
            "Upstream documents a Debian apt command that does not apply to Arch/Omarchy: "
            f"sudo apt-get install {DEBIAN_LIBS}. That command was not run. "
            "File install is in place; graphical runtime is not confirmed."
        )
    result = run_argv([ldd, str(target)])
    output = result.stdout + result.stderr
    missing = []
    for line in output.splitlines():
        if "not found" in line:
            missing.append(line.strip().split()[0])
    if missing or (result.returncode != 0 and "not a dynamic executable" not in output):
        names = ", ".join(missing) or "ldd failed"
        return (
            f"missing Linux libraries: {names}. "
            "This installer does not run sudo or install system packages. "
            "Upstream's Debian/Ubuntu command does not apply to Arch/Omarchy and was not run: "
            f"sudo apt-get install {DEBIAN_LIBS}. "
            "Install the libraries that provide those sonames yourself, then rerun. "
            "The file install was kept."
        )
    return None


def success_message(install_root: Path, source_path: Path, libs: str | None) -> str:
    lines = [
        f"File install complete under {install_root}.",
        f"Linked source: {source_path}.",
        "This did not open a pane, restart Herdr, start terminal-browser, or send messages.",
        "Kitty graphics were not checked. Icons and the browser need a terminal that",
        "displays kitty graphics through Herdr.",
        f"Open Firstpane with: {OPEN_COMMAND}",
        "A Firstpane pane that is already running keeps its old process until it exits.",
        "FirstMate, if configured, is optional. Without it, agent list and pull requests",
        "still work; the message box and notes do not.",
        "An existing valid terminal_browser_root is kept and is not patched in place.",
        "Recovery: previous source and browser trees, if replaced, are the .previous",
        f"directories under {install_root}. Config unknown keys were kept. Rerun this",
        "installer to repeat; it will not link twice or replace a foreign path.",
    ]
    if libs:
        lines.append(libs)
    return "\n".join(lines)


def cleanup_staging(staging: Path) -> None:
    if staging.is_symlink():
        return
    if staging.is_dir():
        shutil.rmtree(staging)


def run_argv(argv: list[str]) -> subprocess.CompletedProcess[str]:
    if any("\x00" in arg for arg in argv):
        raise InstallError("refusing command argument containing NUL")
    return subprocess.run(argv, check=False, capture_output=True, text=True)


if __name__ == "__main__":
    sys.exit(main())
